---
import '../styles/global.css';
import fontUrl from '../assets/fonts/bricolage-latin.woff2?url';
import { site } from '../data/site';
import { ui, type Lang } from '../data/content';
import { withBase } from '../lib/paths';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const paths = { es: withBase('/'), en: withBase('/en/') };
const canonical = new URL(paths[lang], site.url).href;
const alternates = (['es', 'en'] as const).map((l) => ({ l, href: new URL(paths[l], site.url).href }));
const ogImage = new URL(withBase('/og.png'), site.url).href;
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.l} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#eef1f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1729" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={t.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Aplica el tema antes de pintar, para que no parpadee -->
    <script is:inline>
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <slot />
    <script is:inline>
      document.querySelector('.theme').addEventListener('click', function () {
        var r = document.documentElement;
        var t = r.dataset.theme === 'dark' ? 'light' : 'dark';
        r.dataset.theme = t;
        try { localStorage.setItem('theme', t); } catch (e) {}
      });
    </script>
  </body>
</html>
