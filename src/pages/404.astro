---
import '../styles/global.css';
import { withBase } from '../lib/paths';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Página no encontrada / Page not found</title>
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      try { var t = localStorage.getItem('theme'); } catch (e) {}
      document.documentElement.dataset.theme = t === 'dark' || t === 'light' ? t : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
  </head>
  <body>
    <main class="wrap" style="padding-block: 6rem; max-width: 40rem">
      <h1 style="font-size: 2.5rem; letter-spacing: -0.03em; line-height: 1.1">Esta página no existe.</h1>
      <p style="margin-top: 1rem; color: var(--muted)">This page does not exist.</p>
      <p style="margin-top: 2rem"><a class="btn primary" href={withBase('/')}>Ir al inicio / Go home</a></p>
    </main>
  </body>
</html>
